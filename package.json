{
  "name": "redline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "run:cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "eval:e2e": "tsx --env-file-if-exists=.env evals/e2e.ts",
    "watch": "tsx --env-file-if-exists=.env src/watch.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.18.0"
}
